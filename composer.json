{
    "name": "bitesizedinsights/document-to-markdown",
    "description": "Document to Markdown PHP client: convert PDF, Word, Excel, HTML and scans via Apify, typed DTOs.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "document to markdown",
        "pdf to markdown",
        "docx to markdown",
        "pdf converter",
        "ocr",
        "rag",
        "rag chunks",
        "llm",
        "table extraction",
        "markdown",
        "php",
        "apify",
        "api client"
    ],
    "homepage": "https://github.com/bitesizedinsights/document-to-markdown-php",
    "support": {
        "issues": "https://github.com/bitesizedinsights/document-to-markdown-php/issues",
        "source": "https://github.com/bitesizedinsights/document-to-markdown-php"
    },
    "authors": [
        {
            "name": "bite-sized-insights",
            "homepage": "https://apify.com/bite-sized-insights"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "DocumentToMarkdown\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DocumentToMarkdown\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "pint --test",
        "cs:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
